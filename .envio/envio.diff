+.pn-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 6px 0 14px; }
+.pn-kpis > div { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
+.pn-kpis b { display: block; font-size: 22px; font-variant-numeric: tabular-nums; color: var(--ink); }
+.pn-kpis small { color: var(--text-2); font-size: 12px; }
+.pn-res { border: 1px solid var(--line); border-left: 4px solid #188038; border-radius: 8px; padding: 12px 14px; }
+.pn-res.medio { border-left-color: #e37400; }
+.pn-res.ruim { border-left-color: var(--red); }
+.pn-res h3 { font-size: 16px; }
+.pn-res > p { margin: 0 0 12px; font-size: 13px; color: var(--ink); }
+.pn-fim { margin-top: 10px; }
