diff --git a/src/styles.css b/src/styles.css
index 0706fcc..1171baf 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -1411,3 +1411,31 @@ html.dark .dia-chip b { color: #ff8a92; }
 html.dark .doc-title { background: transparent; border-color: transparent; color: #fff; }
 html.dark .doc-title:focus { background: #191919; border-color: var(--red); }
 html.dark .toast { background: #2b2b2b; color: #f1f1f1; border: 1px solid #3a3a3a; }
+
+/* ---------- Histórico do container, status automático, automações, custos e servidor fora do ar ---------- */
+.hc-bar, .au-bar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
+.hc-bar .input, .au-bar .input { flex: 1 1 200px; }
+.hc-card { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; margin: 8px 0; background: var(--white); }
+.hc-card h3 { margin: 0 0 6px; font-size: 14px; display: flex; gap: 8px; align-items: center; }
+.hc-card h3 small { color: var(--text-3); font-weight: 400; margin-right: auto; }
+.hc-card dl { display: grid; grid-template-columns: max-content 1fr; gap: 2px 14px; margin: 0; font-size: 13px; }
+.hc-card dt { color: var(--text-2); } .hc-card dd { margin: 0; word-break: break-word; }
+.hc-tempo { list-style: none; padding: 0; margin: 4px 0; font-size: 13px; display: flex; flex-direction: column; gap: 4px; }
+.hc-tempo li { border-left: 3px solid var(--line-2); padding: 3px 8px; }
+.hc-tempo time { color: var(--text-3); }
+.hc-de { color: #b3261e; text-decoration: line-through; } .hc-para { color: #188038; font-weight: 500; }
+.hc-x { border: 0; background: none; color: var(--text-3); font-size: 11.5px; text-decoration: underline; cursor: pointer; padding: 0 4px; }
+.hc-boxes { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 2px 0 8px; max-height: 160px; overflow: auto; }
+.sa-list { display: flex; flex-direction: column; gap: 6px; margin: 8px 0; }
+.sa-it { display: flex; gap: 8px; align-items: center; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
+.sa-it > div { flex: 1; display: flex; flex-direction: column; } .sa-it small { color: var(--text-2); }
+.sa-it.off { opacity: .55; }
+.sa-p .sa-bt { grid-column: 1 / -1; display: flex; gap: 6px; margin-top: 4px; }
+.dc-top { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin: 6px 0; }
+.au-tbl { max-height: calc(100dvh - 260px); }
+.au-tbl td small { color: var(--text-3); }
+.srv-faixa { position: fixed; left: 50%; transform: translateX(-50%); top: calc(8px + env(safe-area-inset-top)); z-index: 3000; max-width: min(640px, calc(100vw - 16px)); padding: 8px 14px; border-radius: 10px; font-size: 13.5px; box-shadow: 0 4px 16px rgba(0, 0, 0, .25); }
+.srv-faixa.warn { background: #fef3c7; color: #7c4a03; border: 1px solid #f59e0b; }
+.srv-faixa.bad { background: #fce8e6; color: #8c1d18; border: 1px solid #d93025; }
+.srv-faixa.ok { background: #e6f4ea; color: #0d652d; border: 1px solid #34a853; }
+html.dark .hc-de { color: #f87171; } html.dark .hc-para { color: #4ade80; }
