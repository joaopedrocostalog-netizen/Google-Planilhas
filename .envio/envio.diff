+      let maxC = 1;
+      for (const a in sh.cells) { const q = parseAddr(a); if (q && q.col > maxC) maxC = q.col; }
+      const addrs = [];
+      for (const r of (Array.isArray(ped.rows) ? ped.rows : []).slice(0, 4)) for (let c = 1; c <= Math.min(maxC, 120); c++) addrs.push(addrToStr(Number(r), c));
