+.nt-gate { width: 480px; }
+.nt-gate::backdrop { background: rgba(13, 13, 13, .82); }
+html.dark .chat-msg.adm .chat-bubble { background: #2a1113; border-color: #7a1c22; color: var(--ink); }
+html.dark .chat-adm { color: #ff6b74; }
