diff --git a/ferramentas/monitor.yml b/ferramentas/monitor.yml
new file mode 100644
index 0000000..ca20272
--- /dev/null
+++ b/ferramentas/monitor.yml
@@ -0,0 +1,54 @@
+# Monitor do servidor (Render). PARA ATIVAR: no GitHub, crie o arquivo .github/workflows/monitor.yml com este conteúdo
+# (Add file › Create new file). O conector do Claude não tem permissão para criar workflows.
+# - A cada 10 minutos confere /api/health e mantém o servidor acordado (o plano gratuito "dorme" sem acesso; os
+#   avisos de demurrage e o status automático dependem dele acordado).
+# - Se não responder em 3 tentativas (~3 min), abre a issue "Servidor fora do ar" (o GitHub manda e-mail para quem
+#   acompanha o repositório). Quando volta, comenta e fecha a issue.
+# Obs.: o GitHub pode atrasar alguns minutos as execuções agendadas e desliga agendamentos de repositórios sem
+# atividade por 60 dias.
+name: Monitor do servidor
+on:
+  schedule:
+    - cron: '*/10 * * * *'
+  workflow_dispatch:
+permissions:
+  issues: write
+concurrency:
+  group: monitor-servidor
+  cancel-in-progress: false
+jobs:
+  conferir:
+    runs-on: ubuntu-latest
+    timeout-minutes: 8
+    steps:
+      - name: Conferir o servidor
+        id: saude
+        run: |
+          URL="https://planilhas-servidor.onrender.com/api/health"
+          ok=0
+          for i in 1 2 3; do
+            if curl -fsS --max-time 60 "$URL" -o saude.json; then ok=1; break; fi
+            echo "Tentativa $i sem resposta; esperando..."
+            sleep 30
+          done
+          echo "ok=$ok" >> "$GITHUB_OUTPUT"
+          [ "$ok" = 1 ] && cat saude.json || true
+      - name: Avisar (abrir ou fechar a issue)
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          OK: ${{ steps.saude.outputs.ok }}
+        run: |
+          aberta=$(gh issue list -R "$REPO" --state open --search "Servidor fora do ar in:title" --json number --jq '.[0].number' || true)
+          agora=$(TZ=America/Sao_Paulo date '+%d/%m/%Y %H:%M')
+          if [ "$OK" != "1" ]; then
+            if [ -z "$aberta" ]; then
+              gh issue create -R "$REPO" --title "Servidor fora do ar" --body "O servidor das planilhas não respondeu em $agora (3 tentativas em ~3 min). Confira o painel do Render. Esta issue fecha sozinha quando ele voltar."
+            else
+              gh issue comment "$aberta" -R "$REPO" --body "Ainda sem resposta em $agora."
+            fi
+            exit 1
+          elif [ -n "$aberta" ]; then
+            gh issue comment "$aberta" -R "$REPO" --body "Servidor voltou a responder em $agora."
+            gh issue close "$aberta" -R "$REPO"
+          fi
diff --git a/src/automacoes.js b/src/automacoes.js
new file mode 100644
index 0000000..80b4527
--- /dev/null
+++ b/src/automacoes.js
@@ -0,0 +1,85 @@
+// Registro de automações, alertas para o celular e aviso de servidor fora do ar.
+// - App.logAuto(tipo, desc, aba): guarda no servidor o que a planilha fez sozinha (PRÉ STACKING, DATA BAIXA,
+//   confirmações…), com quem estava usando. Administrador › Registro de automações mostra tudo.
+// - App.reportaAlertas(lista): o ALERTA calcula as regras nesta tela; os alertas novos vão para o servidor, que avisa
+//   no celular de quem ligou as notificações (uma vez só, mesmo com várias pessoas abertas).
+// - Faixa no topo quando o servidor não responde (o Render gratuito "dorme" e leva até 1 min para acordar).
+(function (App) {
+  'use strict';
+  const esc = App.esc, $ = (id) => document.getElementById(id);
+  const docId = () => (App.cloudMode && App.cloud && App.cloud.id) || null;
+  const api = (...a) => App.collab.api(...a);
+
+  // ---------- registro ----------
+  let fila = [], tAuto = null;
+  App.logAuto = (tipo, desc, aba) => {
+    if (!docId()) return;
+    fila.push({ tipo, desc: String(desc || '').slice(0, 400), aba: aba || '' });
+    clearTimeout(tAuto);
+    tAuto = setTimeout(() => { const id = docId(), itens = fila.splice(0, 50); if (id && itens.length) api('POST', `/api/docs/${id}/automacoes`, { itens }).catch(() => {}); }, 1500);
+  };
+  App.commands.def('automacoes', 'Registro de automações', async () => {
+    if (!docId()) return App.emit('notify', 'O registro de automações fica no servidor: abra a planilha na nuvem.');
+    let lista;
+    try { lista = await api('GET', `/api/docs/${docId()}/automacoes`); } catch (e) { return App.emit('notify', e.message); }
+    const tipos = [...new Set(lista.map((x) => x.tipo))].sort();
+    const wrap = document.createElement('div');
+    wrap.innerHTML = `<div class="au-bar"><select class="input" id="au-t"><option value="">Todos os tipos</option>${tipos.map((t) => `<option>${esc(t)}</option>`).join('')}</select><input class="input" id="au-q" placeholder="Procurar (container, pessoa…)"></div><div class="ind-tbl au-tbl"><table><thead><tr><th>Quando</th><th>Tipo</th><th>O que aconteceu</th><th>Quem</th></tr></thead><tbody></tbody></table></div><p class="sp-hint" id="au-n"></p>`;
+    const draw = () => {
+      const t = wrap.querySelector('#au-t').value, q = wrap.querySelector('#au-q').value.trim().toLowerCase();
+      const f = lista.filter((x) => (!t || x.tipo === t) && (!q || (x.desc + ' ' + x.por + ' ' + x.aba).toLowerCase().includes(q)));
+      wrap.querySelector('tbody').innerHTML = f.slice(0, 500).map((x) => `<tr><td>${esc(new Date(x.at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }))}</td><td>${esc(x.tipo)}</td><td>${esc(x.desc)}${x.aba ? ` <small>(${esc(x.aba)})</small>` : ''}</td><td>${esc(x.origem === 'servidor' ? 'Servidor (automático)' : x.por)}</td></tr>`).join('') || '<tr><td colspan="4" class="sp-hint">Nada registrado.</td></tr>';
+      wrap.querySelector('#au-n').textContent = `${f.length} ${f.length === 1 ? 'registro' : 'registros'}${f.length > 500 ? ' (mostrando os 500 mais recentes)' : ''}.`;
+    };
+    wrap.querySelector('#au-t').onchange = draw; wrap.querySelector('#au-q').oninput = draw;
+    draw();
+    App.ui.modal({ title: 'Registro de automações', width: '900px', cls: 'modal-tall', body: wrap, buttons: [{ label: 'Fechar', primary: true }] });
+  });
+
+  // ---------- alertas novos → celular ----------
+  const enviados = new Set();
+  let tAl = null, ultimo = null;
+  App.reportaAlertas = (list) => {
+    if (!docId()) return;
+    ultimo = list;
+    clearTimeout(tAl);
+    tAl = setTimeout(() => {
+      const id = docId();
+      if (!id || !ultimo) return;
+      const itens = [];
+      for (const g of ultimo) for (const x of g.rows) {
+        const chave = x.cols.map((y) => y.t).join('|') || 'linha' + x.r;
+        const k = `${g.sh.id}|${g.rule.id || g.rule.name}|${chave}`;
+        if (enviados.has(k)) continue;
+        itens.push({ k, sheetId: g.sh.id, regra: g.rule.id, title: g.rule.name, body: `${g.sh.name}: ${x.cols.map((y) => y.t).join(' · ') || 'linha ' + x.r}` });
+      }
+      if (!itens.length) return;
+      api('POST', `/api/docs/${id}/alertas/novos`, { itens: itens.slice(0, 200) }).then(() => itens.forEach((x) => enviados.add(x.k))).catch(() => {});
+    }, 3000);
+  };
+
+  // ---------- servidor fora do ar ----------
+  let desde = null, timer = null;
+  function faixa() {
+    let el = $('srv-faixa');
+    const st = $('save-status'), off = !!(App.cloudMode && st && st.classList.contains('offline'));
+    if (!off) {
+      if (desde && el) { el.className = 'srv-faixa ok'; el.textContent = 'Conexão com o servidor restabelecida.'; setTimeout(() => { if (!desde && el) el.remove(); }, 3000); }
+      desde = null; clearInterval(timer); timer = null;
+      return;
+    }
+    if (!desde) { desde = Date.now(); timer = setInterval(faixa, 2000); }
+    const s = Math.round((Date.now() - desde) / 1000);
+    if (s < 6) return;
+    if (!el) { el = document.createElement('div'); el.id = 'srv-faixa'; document.body.appendChild(el); }
+    el.className = 'srv-faixa ' + (s > 120 ? 'bad' : 'warn');
+    el.textContent = s > 120
+      ? `Servidor fora do ar há ${Math.round(s / 60)} min. As alterações ficam guardadas aqui e são enviadas quando ele voltar. Se continuar, avise o administrador.`
+      : 'Servidor sem resposta (pode estar acordando, leva até 1 minuto). Tentando reconectar…';
+  }
+  function init() {
+    // confere o estado da conexão a cada 3 s (o indicador "Salvo na nuvem" pode ser criado depois)
+    setInterval(() => { if (!timer) faixa(); }, 3000);
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
+})(window.App);
diff --git a/src/demurrage.js b/src/demurrage.js
new file mode 100644
index 0000000..0ccd7cb
--- /dev/null
+++ b/src/demurrage.js
@@ -0,0 +1,90 @@
+// Demurrage do vazio (PRÉ STACKING VAZIO): prazo = DATA BAIXA + DEMMURAGE (dias livres). Enquanto a DATA (devolução /
+// retirada) estiver vazia e o STATUS não for FINALIZADO:
+// - vence em até 2 dias: CONTAINER, DATA BAIXA e DEMMURAGE ficam em amarelo;  - vencida: em vermelho (sem piscar);
+// - entra no botão ALERTA (regra "Demurrage do vazio", automática) e no aviso do celular (servidor, a cada 30 min).
+// Administrador › Custos de demurrage: diária por armador (20' e 40') para os Indicadores do mês calcularem o custo
+// estimado (devoluções fora do prazo) e o evitado (devoluções no prazo × dias de referência × diária).
+(function (App) {
+  'use strict';
+  const E = App.E, doc = App.doc, esc = App.esc;
+  const P = () => App.preStacking;
+  const serial = (v) => (App.opData ? App.opData.serial(v) : null);
+  const hoje = () => { const d = new Date(); return Math.floor(E.dateToSerial(new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())))); };
+
+  // colunas do vazio (cache por alteração)
+  let cache = new Map();
+  App.on('change', () => { cache = new Map(); });
+  App.on('sheet', () => { cache = new Map(); });
+  function cols(sh) {
+    if (cache.has(sh.id)) return cache.get(sh.id);
+    let c = null;
+    if (P() && P().kindOfPS(sh) === 'vz') {
+      const m = P().colMap(sh), f = (k) => P().findCol(m, P().A[k]);
+      c = { hr: P().headerRow(sh), cont: f('CONTAINER'), baixa: f('DATABAIXA'), dem: f('DEMPS'), data: f('DATA'), status: f('STATUS'), arm: f('ARMADOR'), tipo: f('TIPO'), cli: f('CLIENTE') };
+      if (!c.cont || !c.baixa || !c.dem) c = null;
+    }
+    cache.set(sh.id, c);
+    return c;
+  }
+  const raw = (sh, si, r, c) => { if (!c) return ''; const x = sh.cells[E.addrToStr(r, c)]; const v = x ? x.v : ''; return typeof v === 'string' && v[0] === '=' ? App.value(si, r, c) : v; };
+  // { falta, prazo } quando vence em até 2 dias ou já venceu (linha real); senão null
+  App.demurrageInfo = (sh, si, r) => {
+    const c = cols(sh);
+    if (!c || r <= c.hr) return null;
+    if (!String(raw(sh, si, r, c.cont) || '').trim()) return null;
+    if (String(raw(sh, si, r, c.data) || '').trim()) return null;
+    if (P().norm(raw(sh, si, r, c.status)).includes('FINALIZ')) return null;
+    const b = serial(raw(sh, si, r, c.baixa)), d = Number(String(raw(sh, si, r, c.dem) || '').replace(',', '.'));
+    if (b === null || !(d > 0)) return null;
+    const prazo = Math.floor(b) + d, falta = prazo - hoje();
+    return falta <= 2 ? { falta, prazo } : null;
+  };
+  // estilo das células CONTAINER, DATA BAIXA e DEMMURAGE da linha
+  App.demurrageCell = (sh, si, r, c) => {
+    const k = cols(sh);
+    if (!k || (c !== k.cont && c !== k.baixa && c !== k.dem)) return null;
+    const i = App.demurrageInfo(sh, si, r);
+    if (!i) return null;
+    return i.falta < 0 ? { bg: '#fce8e6', color: '#b3261e', b: true } : { bg: '#fef3c7', color: '#92400e', b: true };
+  };
+  App.demurrageCols = cols;
+
+  // ---------- custos (Administrador › Custos de demurrage) ----------
+  const vz = () => doc.sheets.find((s) => P() && P().kindOfPS(s) === 'vz');
+  const cfg = () => { const s = vz(); return (s && s.demCustos) || { moeda: 'US$', ref: 3, padrao: { d20: 0, d40: 0 }, tabela: [] }; };
+  // diária do armador para o tipo (20 ou 40 pés)
+  App.demDiaria = (armador, tipo) => {
+    const c = cfg(), a = P().norm(armador), t = /^\s*20/.test(String(tipo || '')) ? 'd20' : 'd40';
+    const lin = (c.tabela || []).find((x) => { const n = P().norm(x.armador); return n && (a === n || (n.length >= 3 && a.includes(n))); });
+    return Number((lin && lin[t]) || (c.padrao && c.padrao[t]) || 0);
+  };
+  App.demCfg = cfg;
+  App.commands.def('demCustos', 'Custos de demurrage', () => {
+    if (App.adminOnly && App.adminOnly()) return App.emit('notify', 'Somente administradores ajustam os custos de demurrage.');
+    const s = vz();
+    if (!s) return App.emit('notify', 'A aba PRÉ STACKING VAZIO não foi encontrada.');
+    const c = JSON.parse(JSON.stringify(cfg()));
+    const linha = (x) => `<tr><td><input class="input" data-a value="${esc(x.armador || '')}" placeholder="MSC"></td><td><input class="input" data-20 type="number" min="0" step="0.01" value="${x.d20 || ''}"></td><td><input class="input" data-40 type="number" min="0" step="0.01" value="${x.d40 || ''}"></td><td><button class="icon-btn" data-x title="Tirar">✕</button></td></tr>`;
+    const m = App.ui.modal({
+      title: 'Custos de demurrage', width: '600px',
+      body: `<p class="sp-hint">Diária cobrada por armador depois dos dias livres (DEMMURAGE). Usada nos Indicadores do mês: <b>custo estimado</b> = dias de atraso × diária; <b>custo evitado</b> = devoluções no prazo × dias de referência × diária.</p>
+        <div class="dc-top"><label class="field"><span>Moeda</span><select class="input" id="dc-moeda">${['US$', 'R$', '€'].map((x) => `<option${c.moeda === x ? ' selected' : ''}>${x}</option>`).join('')}</select></label>
+        <label class="field"><span>Dias de referência (evitado)</span><input class="input" id="dc-ref" type="number" min="1" max="60" value="${c.ref || 3}"></label>
+        <label class="field"><span>Padrão 20'</span><input class="input" id="dc-p20" type="number" min="0" step="0.01" value="${(c.padrao || {}).d20 || ''}"></label>
+        <label class="field"><span>Padrão 40'</span><input class="input" id="dc-p40" type="number" min="0" step="0.01" value="${(c.padrao || {}).d40 || ''}"></label></div>
+        <div class="ind-tbl"><table><thead><tr><th>Armador</th><th>Diária 20'</th><th>Diária 40'</th><th></th></tr></thead><tbody id="dc-rows">${(c.tabela || []).map(linha).join('')}</tbody></table></div>
+        <button class="btn btn-sm" id="dc-add" style="margin-top:8px">+ Armador</button>`,
+      buttons: [{ label: 'Cancelar' }, { label: 'Salvar', primary: true, action: (d) => {
+        const num = (sel) => Number((d.querySelector(sel) || {}).value) || 0;
+        const tabela = [...d.querySelectorAll('#dc-rows tr')].map((tr) => ({ armador: tr.querySelector('[data-a]').value.trim(), d20: Number(tr.querySelector('[data-20]').value) || 0, d40: Number(tr.querySelector('[data-40]').value) || 0 })).filter((x) => x.armador);
+        const novo = { moeda: d.querySelector('#dc-moeda').value, ref: Math.max(1, num('#dc-ref') || 3), padrao: { d20: num('#dc-p20'), d40: num('#dc-p40') }, tabela };
+        App.change('Custos de demurrage', () => { s.demCustos = novo; });
+        App.emit('notify', 'Custos de demurrage salvos.');
+      } }],
+    });
+    const rows = m.el.querySelector('#dc-rows');
+    const liga = () => rows.querySelectorAll('[data-x]').forEach((b) => (b.onclick = () => b.closest('tr').remove()));
+    m.el.querySelector('#dc-add').onclick = () => { rows.insertAdjacentHTML('beforeend', linha({})); liga(); };
+    liga();
+  });
+})(window.App);
diff --git a/src/historico.js b/src/historico.js
new file mode 100644
index 0000000..a2da582
--- /dev/null
+++ b/src/historico.js
@@ -0,0 +1,140 @@
+// Histórico do container (botão direito na célula › Histórico do container, ou Ferramentas): ficha com as linhas
+// atuais do container em todas as abas (MAPA, PRÉ STACKING…) e a linha do tempo de tudo o que mudou nelas, com quem e
+// quando — inclusive mudanças em que o número aparece mesmo antes de trocar de linha.
+// Personalizar: escolher as colunas que aparecem, esconder campos vazios, pessoas, mudanças de colunas
+// específicas e itens um a um. As escolhas ficam guardadas neste aparelho. Dá para imprimir o relatório.
+(function (App) {
+  'use strict';
+  const E = App.E, doc = App.doc, esc = App.esc;
+  const KEY = 'planilhas:histcont';
+  const norm = (s) => String(s === null || s === undefined ? '' : s).toUpperCase().replace(/[^A-Z0-9]/g, '');
+  const prefsLe = () => { try { return Object.assign({ cols: null, vazios: true, ocultos: [], pessoas: [], colsTempo: null }, JSON.parse(localStorage.getItem(KEY) || '{}')); } catch (e) { return { cols: null, vazios: true, ocultos: [], pessoas: [], colsTempo: null }; } };
+  const prefsGrava = (p) => { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch (e) { /* ignora */ } };
+
+  // cabeçalho de cada coluna da aba (pela linha do cabeçalho do PRÉ STACKING/MAPA)
+  function cabecalho(sh) {
+    const P = App.preStacking, hr = P ? P.headerRow(sh) : 1, out = {};
+    const maxC = App.usedRange(sh).maxC || 1;
+    for (let c = 1; c <= maxC; c++) { const n = (sh.colNames || {})[c] || (sh.cells[E.addrToStr(hr, c)] || {}).v; if (n !== undefined && n !== null && String(n).trim()) out[c] = String(n).trim(); }
+    return { hr, out };
+  }
+  // linhas atuais com o container (colunas de container de cada aba)
+  function achaLinhas(cont) {
+    const res = [];
+    App.withReal(() => doc.sheets.forEach((sh, si) => {
+      if (sh.shadow) return;
+      const { hr, out } = cabecalho(sh);
+      const cc = Object.keys(out).map(Number).filter((c) => /CONTAINER$/.test(norm(out[c])));
+      if (!cc.length) return;
+      const rows = new Set();
+      for (const a in sh.cells) {
+        const p = E.parseAddr(a);
+        if (!p || p.row <= hr || !cc.includes(p.col)) continue;
+        if (norm(sh.cells[a].v).includes(cont)) rows.add(p.row);
+      }
+      for (const r of rows) {
+        const campos = Object.keys(out).map(Number).map((c) => ({ c, nome: out[c], v: App.fmtValue ? App.fmtValue(App.value(si, r, c), App.style(sh, r, c).nf) : String(App.value(si, r, c) ?? '') }));
+        res.push({ sh, si, r, campos, cab: out });
+      }
+    }));
+    return res;
+  }
+
+  async function abrir(inicial) {
+    let cont = norm(inicial || '');
+    if (!cont) {
+      const s = App.sel, i = s ? App.cellInfo(s.ar, s.ac) : null;
+      if (i && /[A-Z]{4}\d{6}/.test(norm(i.text))) cont = norm(i.text).match(/[A-Z]{4}\d{6,7}/)[0];
+    }
+    const wrap = document.createElement('div');
+    wrap.className = 'hc';
+    wrap.innerHTML = `<div class="hc-bar"><input class="input" id="hc-c" placeholder="Número do container (ex.: CSQU3054383)" value="${esc(cont)}"><button class="btn btn-primary" id="hc-ir">Ver</button><button class="btn" id="hc-pers">Personalizar</button></div><div id="hc-res"><p class="sp-hint">Digite o número e toque em Ver.</p></div>`;
+    const m = App.ui.modal({ title: 'Histórico do container', width: '900px', cls: 'modal-tall', body: wrap, buttons: [{ label: 'Imprimir', action: () => { imprimir(wrap); return false; } }, { label: 'Fechar', primary: true }] });
+    let dados = null;
+    const res = wrap.querySelector('#hc-res');
+    const carrega = async () => {
+      cont = norm(wrap.querySelector('#hc-c').value);
+      if (cont.length < 6) { res.innerHTML = '<p class="sp-hint">Informe o número do container.</p>'; return; }
+      res.innerHTML = '<p class="sp-hint">Procurando…</p>';
+      const linhas = achaLinhas(cont);
+      let tempo = [];
+      if (App.cloudMode && App.cloud && App.cloud.id) {
+        try { tempo = await App.collab.api('POST', `/api/docs/${App.cloud.id}/historico-container`, { container: cont, linhas: linhas.map((l) => ({ sheetId: l.sh.id, rows: [l.r] })) }); }
+        catch (e) { res.innerHTML = `<p class="sp-hint">${esc(e.message)}</p>`; return; }
+      }
+      dados = { cont, linhas, tempo };
+      desenha();
+    };
+    function desenha() {
+      if (!dados) return;
+      const pr = prefsLe();
+      const nomeCol = (s, a) => { const l = dados.linhas.find((x) => x.sh.id === s); const sh = doc.sheets.find((x) => x.id === s); const p = E.parseAddr(a); const cab = l ? l.cab : sh ? cabecalho(sh).out : {}; return (p && cab[p.col]) || (p ? E.numToCol(p.col) : a); };
+      const abaNome = (s) => (doc.sheets.find((x) => x.id === s) || {}).name || '?';
+      const ficha = dados.linhas.map((l) => {
+        const campos = l.campos.filter((f) => (!pr.cols || pr.cols.includes(f.nome)) && (!pr.vazios || String(f.v).trim()));
