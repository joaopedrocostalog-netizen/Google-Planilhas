+      const token = App.cloud.token;
+      const T = { cfg: r, t0: Date.now(), fimEnvio: 0, vus: [], enviados: 0, acks: 0, recebidos: 0, erros: 0, quedas: 0, falhas: 0, lat: [], pontos: [], srv: [], parado: false, fase: 'Conectando…' };
