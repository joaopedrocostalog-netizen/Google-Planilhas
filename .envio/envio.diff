+++ b/server/glitch-config.js
@@ -0,0 +1,13 @@
+// Detecta se está rodando em Glitch e ajusta configurações
+module.exports = function detectGlitch() {
+  const inGlitch = process.env.PROJECT_DOMAIN ? true : false;
+  
+  if (inGlitch) {
+    console.log('[Glitch] Detectado Glitch. Domínio:', process.env.PROJECT_DOMAIN);
+    // Glitch fornece essas variáveis automaticamente
+    process.env.GLITCH_URL = `https://${process.env.PROJECT_DOMAIN}.glitch.me`;
+    console.log('[Glitch] URL do servidor:', process.env.GLITCH_URL);
+  }
+  
+  return inGlitch;
+};
