+          a.obs = d.querySelector('#sa-o').value.trim(); a.ativo = d.querySelector('#sa-a').checked;
+          if (!a.horarios.length) { App.emit('notify', 'Informe ao menos um horário (ex.: 08:00).'); return false; }
